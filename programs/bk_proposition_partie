:- module(bk_proposition_partie, 
          [
            
          ]
         ).
 
:- use_module(fonctions_enonce).

:- discontiguous high_number_solutions/3.
:- discontiguous medium_number_solutions/3.
:- discontiguous small_number_solutions/3.
:- discontiguous very_high_number_solutions/2.
:- discontiguous very_small_number_solutions/2.

/* ================================ RULES =================================== */

unique_solution_instance(Instance) :-
    fonctions_enonces:
	nb_solutions_instance(_Nb_categories, Instance, 1).

% ----------
	% The difficulty associated with an instance depends on the number 
	% of solutions and the number of categories of difficulty (but also on the
    % number of equalities in one rare case )
    % 3 categories [easy, intermediary, difficulty]
    % 5 categories [very_easy, easy, intermediary, difficulty, very_difficult]

    % Avec 3 categories de difficultes, un enonce est facile s'il a 3 egalites
difficulty_instance(_Positions, Instance, 3, easy) :-
    nb_equalities(Instance, 3).

    % Avec 5 categories de difficultes, un enonce est tres facile s'il a 3 egalites
difficulty_instance(_Positions, Instance, 5, very_easy) :-
    nb_equalities(Instance, 3).

difficulty_instance(pos,						% tient compte des positions
					Instance, Nb_categories, Difficulty) :-
	!,
	fonctions_enonce:
	nb_solutions_instance(Nb_categories, Instance, Nb_solutions),
	difficulty_instance_solutions(pos, Nb_solutions, Difficulty, Nb_categories).

difficulty_instance(no_pos,					% ne tient pas compte des positions
					Instance, Nb_categories, Difficulty) :-
	!,
	fonctions_enonce:
	nb_solutions_instance(Nb_categories, Instance, Nb_solutions),
    Nb_solutions1 is Nb_solutions / 24,
	difficulty_instance_solutions(no_pos, Nb_solutions1, Difficulty, 
								  Nb_categories).

% ----------
    % difficulte en fonction du nombre de solutions sans prendre en compte les positions
difficulty_instance_solutions(Positions,
							  Nb_solutions, very_difficult, _Nb_categories) :-               
    very_high_number_solutions(Positions, T),
    Nb_solutions >= T,
    !.

difficulty_instance_solutions(Positions,
							  Nb_solutions, difficult, Nb_categories) :-
    high_number_solutions(Positions, T, Nb_categories),
    Nb_solutions >= T,
    !.

difficulty_instance_solutions(Positions,
							  Nb_solutions, intermediary, Nb_categories) :-
    medium_number_solutions(Positions, T, Nb_categories),
    Nb_solutions >= T,
    !.

difficulty_instance_solutions(Positions,
							  Nb_solutions, easy, Nb_categories) :-
    small_number_solutions(Positions, T, Nb_categories),
    Nb_solutions >= T,
    !.

difficulty_instance_solutions(_Position, _Nb_solutions, very_easy, 
							   _Nb_categories).

/* ========================= DEFINITION DES SEUILS ========================== */


% -------------------------ON TIENT COMPTE DES POSITIONS ---------------------*/

    % Chaque nombre represente le nombre de solutions minimal pour etre dans la
    % categorie indiquee par le nom du predicat (easy, difficult, ...)

    % Pour 3 categories, en prenant en compte les positions.
	% limites inferieures des categories
high_number_solutions(pos, 120, 3).
medium_number_solutions(pos, 48, 3).
small_number_solutions(pos, 24, 3).

    % Pour 5 categories, en prenant en compte les positions.
	% limites inferieures des categories
very_high_number_solutions(pos, 168).
high_number_solutions(pos, 96, 5).
medium_number_solutions(pos, 72, 5).
small_number_solutions(pos, 48, 5).
very_small_number_solutions(pos, 24).

/* -------------------- SANS TENIR COMPTE DES POSITIONS --------------------- */

    % Pour 3 categories, en ne prenant pas en compte les positions.
	% limites inferieures des categories
high_number_solutions(no_pos, 5, 3).
medium_number_solutions(no_pos, 2, 3).
small_number_solutions(no_pos, 1, 3).

    % Pour 5 categories, en ne prenant pas en compte les positions.
	% limites inferieures des categories
very_high_number_solutions(no_pos, 7).
high_number_solutions(no_pos, 4, 5).
medium_number_solutions(no_pos, 72, 5).
small_number_solutions(no_pos, 2, 5).
very_small_number_solutions(no_pos, 1).

